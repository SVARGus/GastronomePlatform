# Шаблон секретов прод-развёртывания.
# Скопируйте в КОРЕНЬ репозитория как .env (рядом с docker-compose.prod.yml):
#   cp deploy/.env.example .env
# и заполните значения. Файл .env в .gitignore — в репозиторий не попадает.

# Домен сайта (без https://) — Caddy выпустит сертификат автоматически
DOMAIN=example.ru

# Пароль PostgreSQL (пользователь gastronome, база gastronome_db)
# Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=

# Пароль RabbitMQ (пользователь gastronome)
RABBITMQ_PASSWORD=

# Пароль администратора Seq (вход в веб-панель через SSH-туннель)
SEQ_ADMIN_PASSWORD=

# Секрет подписи JWT — минимум 32 символа, ОБЯЗАТЕЛЬНО новый для прода
# (dev-значение из appsettings.Development.json использовать нельзя).
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=
