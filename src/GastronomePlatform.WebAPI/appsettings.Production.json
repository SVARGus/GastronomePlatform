{
  "_comment": "Несекретные прод-дефолты под docker-compose.prod.yml (hostnames контейнеров). Секреты (пароль БД в строке подключения, JwtSettings:Secret, пароль RabbitMQ) приходят ТОЛЬКО через переменные окружения из .env — см. deploy/.env.example.",

  "Database": {
    "MigrateOnStartup": true
  },

  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "gastronome"
  },

  "Seq": {
    "ServerUrl": "http://seq:5341"
  },

  "Media": {
    "Storage": {
      "Provider": "Local",
      "LocalBasePath": "/data/media"
    }
  },

  "Subscriptions": {
    "Scheduler": {
      "IntervalMinutes": 5
    }
  },

  "JwtSettings": {
    "Issuer": "GastronomePlatform",
    "Audience": "GastronomePlatform.Client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
